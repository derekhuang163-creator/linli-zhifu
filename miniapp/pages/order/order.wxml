<view class="container">
  <view wx:if="{{!pageReady}}" class="card">
    <view class="match-tip">正在加载订单…</view>
  </view>

  <block wx:else>
    <view class="title">订单确认</view>

    <view class="card">
      <view class="order-id">订单号 {{order.id || "待生成"}}</view>
      <view class="order-status">{{order.statusText || order.status}}</view>
    </view>

    <view class="card">
      <view class="section-title">服务内容</view>
      <view class="request">{{order.request.rawText}}</view>
      <view class="row">
        <text>服务者</text>
        <text>{{order.provider.name}}</text>
      </view>
      <view class="row">
        <text>信用分</text>
        <text>{{order.provider.credit}}</text>
      </view>
      <view class="row">
        <text>参考价格</text>
        <text>¥{{order.provider.priceFrom || 0}} 起</text>
      </view>
    </view>

    <view class="card timeline-card">
      <view class="section-title">履约状态</view>
      <view class="timeline">
        <view wx:for="{{history}}" wx:key="id" class="timeline-item {{index === history.length - 1 ? 'active' : ''}}">
          <view class="timeline-line"></view>
          <view class="timeline-dot"></view>
          <view class="timeline-content">
            <view class="timeline-status">{{item.statusText || item.to}}</view>
            <view class="timeline-time">{{item.timeText || item.createdAt}}</view>
          </view>
        </view>
        <view wx:if="{{!history.length}}" class="timeline-empty">订单创建后，服务履约进度会显示在这里</view>
      </view>
    </view>

    <view class="card notice">
      当前为 MVP 演示订单。下一步将接入真实支付、服务时间、定位、履约状态和售后。
    </view>

    <view wx:if="{{order.status === 'WAITING_PROVIDER'}}" class="card notice">订单正在等待服务者接单。请到“服务者工作台”接受订单，再返回这里查看状态。</view>

    <button wx:if="{{order.status !== 'WAITING_PROVIDER' && order.status !== 'USER_ACCEPTED' && order.status !== 'CANCELLED' && order.status !== 'DISPUTED' && order.status !== 'NO_ORDER'}}"
      class="primary-btn"
      bindtap="nextStatus"
      disabled="{{loading}}">
      {{loading ? "处理中…" : "推进下一步状态（测试）"}}
    </button>

    <button class="primary-btn" bindtap="backHome">返回首页</button>
  </block>
</view>