<view class="container">
  <view class="title">服务者工作台</view>
  <view class="card">
    <view class="label">当前服务者</view>
    <view class="name">{{provider.name}}</view>
    <view class="meta">信用分 {{provider.credit}} · 已完成 {{provider.completedOrders}} 单</view>
    <view class="meta">状态：{{provider.status === 'approved' ? '已审核' : provider.status}}</view>
  </view>

  <view class="section-title">我的订单</view>
  <view wx:if="{{loading && !orders.length}}" class="card muted">正在加载订单…</view>
  <view wx:elif="{{!orders.length}}" class="card muted">目前还没有订单。用户创建订单后，这里会显示待接单任务。</view>
  <view wx:for="{{orders}}" wx:key="id" class="card order">
    <view class="order-id">订单号 {{item.id}}</view>
    <view class="request">{{item.rawText || item.request.rawText}}</view>
    <view class="status">{{item.statusText || item.status}}</view>
    <view wx:if="{{item.createdAtText}}" class="order-time">创建时间：{{item.createdAtText}}</view>
    <button wx:if="{{item.status === 'WAITING_PROVIDER'}}" size="mini" type="primary" bindtap="accept" data-id="{{item.id}}" disabled="{{loading}}">接受订单</button>
    <view wx:elif="{{item.status === 'ACCEPTED'}}" class="accepted-tip">已接单。用户端订单状态已更新。</view>
  </view>
  <view wx:if="{{errorText}}" class="error-text">{{errorText}}</view>
  <button class="primary-btn" bindtap="demoRefresh" loading="{{loading}}" disabled="{{loading}}">刷新订单</button>
</view>