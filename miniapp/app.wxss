page{background:#f6f7f9;color:#1f2937;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif}.container{padding:32rpx;box-sizing:border-box}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 8rpx 30rpx rgba(31,41,55,.05)}.primary-btn{background:#111827;color:#fff;border-radius:16rpx;font-size:30rpx}.primary-btn[disabled]{opacity:.45}.muted{color:#6b7280}.small{font-size:24rpx}.title{font-size:42rpx;font-weight:700}.section-title{font-size:30rpx;font-weight:700;margin:34rpx 4rpx 18rpx}